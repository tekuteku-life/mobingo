{
	"name": "mobingo",
	"private": true,
	"version": "1.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -p jsconfig.json && tsc -p jsconfig.sw.json && vite build",
		"preview": "vite preview",
		"check:syntax": "node scripts/check_syntax.js",
		"check:types": "tsc -p jsconfig.json && tsc -p jsconfig.sw.json",
		"lint:indent": "node scripts/check_indent.js",
		"lint": "npm run lint:indent && npm run check:syntax && npm run check:version && npm run check:types",
		"test": "node --test --test-concurrency=1 test/unit/*.test.js test/integration/*.test.js test/system/*.test.js",
		"test:unit": "node --test test/unit/*.test.js",
		"test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
		"test:system": "node --test --test-concurrency=1 test/system/*.test.js",
		"test:ui": "node --test --test-concurrency=1 test/ui/*.test.js",
		"test:all": "npm test && npm run test:ui",
		"test:coverage": "node scripts/coverage.js",
		"check:version": "node scripts/check_version.js"
	},
	"dependencies": {
		"canvas-confetti": "^1.9.4",
		"jsqr": "^1.4.0",
		"lucide-react": "^1.16.0",
		"qrcode": "^1.5.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@bcoe/v8-coverage": "^1.0.2",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^22.13.0",
		"@types/qrcode": "^1.5.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"istanbul-lib-coverage": "^3.2.2",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.2",
		"v8-to-istanbul": "^9.3.0",
		"vite": "^6.0.7"
	}
}
